doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title
        link(rel="stylesheet" href="/css/style.css")
    body
        header
            h1 La Espiga de Oro S.R.L.
            h2 Sistema de Gestión Integrado
        main
            section(style="text-align: center; padding: 2rem; max-width: 400px; margin: 0 auto;")
                h3 Registro de Nuevo Usuario
                
                if error
                    div.pedido-danger-zone(style="margin-bottom: 1rem;")
                        p= error
                        
                form(action="/registro" method="POST" style="text-align: left; padding: 1.5rem; border: 1px solid #ccc; border-radius: 8px;")
                    div(style="margin-bottom: 1rem;")
                        label(for="nombre") Nombre de Usuario
                        input#nombre(type="text" name="nombre" style="width: 100%; padding: 0.5rem;" required)
                    div(style="margin-bottom: 1rem;")
                        label(for="email") Correo Electrónico
                        input#email(type="email" name="email" style="width: 100%; padding: 0.5rem;" required)
                    div(style="margin-bottom: 1.5rem;")
                        label(for="password") Contraseña
                        input#password(type="password" name="password" style="width: 100%; padding: 0.5rem;" required)
                    button.btn-primary(type="submit" style="width: 100%;") Crear Usuario
                hr(style="margin: 2rem 0; border-top: 1px solid #ddd;")
                p ¿Ya tenés una cuenta? 
                    a(href="/login" style="font-weight:bold;") Volver al Login